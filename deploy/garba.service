# Сервер ГАРБА: systemd сам запускает его при старте машины и поднимает после падения.
[Unit]
Description=GARBA backend (HTTP + Socket.IO)
After=network-online.target
Wants=network-online.target

[Service]
User=garba
Group=garba
WorkingDirectory=/opt/garba/backend
Environment=NODE_ENV=production
Environment=PORT=3000
# Снаружи — только через Caddy по https.
Environment=HOST=127.0.0.1
Environment=GARBA_DB=/var/lib/garba/garba.db
# Почта для связи в политике конфиденциальности (/privacy). Без неё — «через профиль в игре».
Environment=GARBA_CONTACT_EMAIL=bot20aian@gmail.com
# Веб-сборка игры (браузер и Telegram Mini App) — отдаётся по адресу /play/ (07.10.2026).
Environment=GARBA_WEB_DIR=/opt/garba/web
# Токен бота Telegram (TELEGRAM_BOT_TOKEN=...) — в git не лежит, кладёт set-telegram-token.sh.
# Нет файла — игра работает, вход через Telegram выключен.
EnvironmentFile=-/etc/garba/telegram.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
# Песочница (28.09.2026, после взлома 27.09): писать можно только в папку базы,
# код в /opt/garba — только для чтения (владелец root), новых прав не получить.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/garba
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=1200M

[Install]
WantedBy=multi-user.target
